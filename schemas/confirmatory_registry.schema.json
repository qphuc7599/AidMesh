{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidmesh.example/schemas/confirmatory_registry.schema.json",
  "title": "AidMesh confirmatory experiment registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "freeze_status",
    "claims",
    "approval",
    "scenarios",
    "analysis"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "pattern": "^[A-Z0-9_-]{3,64}$"},
    "freeze_status": {"enum": ["DRAFT", "FROZEN"]},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_questions", "decision_rules"],
      "properties": {
        "primary_questions": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["RQ1", "RQ2", "RQ5", "RQ6"]},
          "uniqueItems": true
        },
        "decision_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "date_utc", "meaningful_effect_statement"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "date_utc": {"type": "string", "minLength": 1},
        "meaningful_effect_statement": {"type": "string", "minLength": 1}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["config", "seed_start", "seed_count", "methods"],
        "properties": {
          "config": {"type": "string", "minLength": 1},
          "seed_start": {"type": "integer", "minimum": 0},
          "seed_count": {"type": "integer", "minimum": 1, "maximum": 10000},
          "methods": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_level",
        "bootstrap_resamples",
        "permutation_resamples",
        "multiplicity",
        "comparisons"
      ],
      "properties": {
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "bootstrap_resamples": {"type": "integer", "minimum": 1000},
        "permutation_resamples": {"type": "integer", "minimum": 1000},
        "multiplicity": {"const": "holm"},
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "treatment", "control", "metrics", "alternative"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Z0-9_-]{3,64}$"},
              "treatment": {"type": "string", "minLength": 1},
              "control": {"type": "string", "minLength": 1},
              "metrics": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "alternative": {"enum": ["greater", "less", "two-sided"]},
              "scenarios": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
