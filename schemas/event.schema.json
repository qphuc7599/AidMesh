{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidmesh.example/schemas/event.schema.json",
  "title": "AidMesh immutable raw event v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "experiment_id", "scenario_id", "phase", "method", "seed", "sim_time_us", "event_seq", "actor_id", "actor_role", "event_type", "safety_domain", "config_hash", "software_commit"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "pattern": "^E[0-8]$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["development", "tuning", "confirmatory", "external", "stress"]},
    "method": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "sim_time_us": {"type": "integer", "minimum": 0},
    "event_seq": {"type": "integer", "minimum": 0},
    "actor_id": {"type": "string", "minLength": 1},
    "actor_role": {"enum": ["consortium", "issuer", "beneficiary", "site", "witness", "relay", "gateway", "contract", "allocator", "adversary", "harness"]},
    "event_type": {"type": "string", "minLength": 1},
    "safety_domain": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "risk_cell": {"type": ["string", "null"]},
    "group_code": {"type": ["string", "null"]},
    "category": {"type": ["string", "null"]},
    "value_units": {"type": ["integer", "null"], "minimum": 0},
    "nullifier_hash": {"type": ["string", "null"]},
    "receipt_id": {"type": ["string", "null"]},
    "bundle_id": {"type": ["string", "null"]},
    "parent_event_seq": {"type": ["integer", "null"], "minimum": 0},
    "path": {"enum": ["quorum", "fallback", "online", "none", null]},
    "committee_K": {"type": ["integer", "null"], "minimum": 1},
    "threshold_q": {"type": ["integer", "null"], "minimum": 1},
    "registered_f": {"type": ["integer", "null"], "minimum": 0},
    "rights_before": {"type": ["integer", "null"], "minimum": 0},
    "rights_after": {"type": ["integer", "null"], "minimum": 0},
    "payload_bytes": {"type": ["integer", "null"], "minimum": 0},
    "copies": {"type": ["integer", "null"], "minimum": 0},
    "deadline_us": {"type": ["integer", "null"], "minimum": 0},
    "terminal_outcome": {"enum": ["settled", "expired", "evicted", "dropped", "rejected", "conflict_lost", "pending", null]},
    "failure_class": {"type": ["string", "null"]},
    "failure_code": {"type": ["string", "null"]},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "software_commit": {"type": "string", "minLength": 1}
  }
}

